    "fig_strong_path = project_root / \"output\" / \"figures\" / \"step4_strong_interests_coverage.png\"\n",
    "# plot_strong_interests_coverage(df_strong_cov, output_path=fig_strong_path)\n",
    "display(Image(filename=str(fig_strong_path)))\n"
   ]
